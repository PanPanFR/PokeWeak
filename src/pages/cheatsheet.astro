---
import MainLayout from '../layouts/MainLayout.astro';
import TypeIcon from '../components/TypeIcon.astro';
import TypeCheckerIsland from '../components/TypeCheckerIsland.jsx';
import typeChart from '../data/types.json';
import { calculateWeaknesses } from '../utils/typeCalc';

const typeKeys = Object.keys(typeChart);

const weaknessData = typeKeys.map((type) => {
  const w = calculateWeaknesses([type], typeChart);
  const superEffective = [...w.quadWeak, ...w.doubleWeak];
  return { type, superEffective, weaknesses: w };
});
---

<MainLayout title="Type Cheatsheet — PokeWeak" description="Quick reference for all Pokémon type matchups" currentPath="/cheatsheet">
  <h1 style="font-size:16px;font-weight:700;margin:0 0 12px;">Type Matchups</h1>
  <TypeCheckerIsland client:load />

  <div class="cs-grid">
    {
      weaknessData.map(({ type, superEffective, weaknesses }) => {
        const c = `var(--color-pk-${type.toLowerCase()})`;
        const hasSpecial = weaknesses.immune.length > 0 || weaknesses.doubleResist.length > 0;
        return (
          <div class="cs-card" style={`--tc:${c};`}>
            <div class="cs-head">
              <TypeIcon typeName={type} size={16} />
              <span class="cs-name">{type}</span>
            </div>
            <div class="cs-body">
              <div class="cs-row">
                <span class="cs-label">Weak</span>
                <span class="cs-badges">
                  {superEffective.length > 0 ? superEffective.map((atk) => (
                    <span class="cs-badge" title={`${atk} → ×2`}>
                      <TypeIcon typeName={atk} size={12} />
                    </span>
                  )) : <span class="cs-none">—</span>}
                </span>
              </div>
              <div class="cs-row">
                <span class="cs-label">Resist</span>
                <span class="cs-badges">
                  {weaknesses.resist.length > 0 ? weaknesses.resist.map((atk) => (
                    <span class="cs-badge cs-badge--resist" title={`${atk} → ×½`}>
                      <TypeIcon typeName={atk} size={12} />
                    </span>
                  )) : <span class="cs-none">—</span>}
                </span>
              </div>
              {hasSpecial && (
                <div class="cs-row">
                  <span class="cs-label cs-label--special">Imm</span>
                  <span class="cs-badges">
                    {weaknesses.immune.map((atk) => (
                      <span class="cs-badge cs-badge--immune" title={`${atk} → ×0`}>
                        <TypeIcon typeName={atk} size={12} />
                      </span>
                    ))}
                    {weaknesses.doubleResist.map((atk) => (
                      <span class="cs-badge cs-badge--resist" title={`${atk} → ×¼`}>
                        <TypeIcon typeName={atk} size={12} />
                      </span>
                    ))}
                  </span>
                </div>
              )}
            </div>
          </div>
        );
      })
    }
  </div>
</MainLayout>

<style is:global>
  .cs-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 8px;
  }

  .cs-card {
    display: flex;
    flex-direction: column;
    border-radius: 10px;
    overflow: hidden;
    border: 1px solid rgba(255,255,255,0.07);
    background: var(--color-surface, #1E1E1E);
  }

  .cs-head {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 5px;
    padding: 7px 6px;
    background: color-mix(in srgb, var(--tc) 14%, transparent);
    border-bottom: 1px solid rgba(255,255,255,0.05);
  }

  .cs-name {
    font-size: 12px;
    font-weight: 700;
  }

  .cs-body {
    padding: 6px 8px 8px;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .cs-row {
    display: flex;
    align-items: flex-start;
    gap: 6px;
  }

  .cs-label {
    font-size: 9px;
    font-weight: 700;
    color: #777;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    width: 30px;
    flex-shrink: 0;
    line-height: 20px;
  }

  .cs-label--special {
    color: #666;
  }

  .cs-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 3px;
  }

  .cs-badge {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 22px;
    height: 22px;
    border-radius: 5px;
    background: rgba(255,255,255,0.07);
  }

  .cs-badge--resist {
    opacity: 0.6;
  }

  .cs-badge--immune {
    opacity: 0.3;
  }

  .cs-none {
    font-size: 10px;
    color: #444;
    line-height: 22px;
  }
</style>
