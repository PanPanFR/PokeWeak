---
import MainLayout from '../layouts/MainLayout.astro';
import TypeCheckerIsland from '../components/TypeCheckerIsland.jsx';
---

<MainLayout title="Type Cheatsheet — PokeWeak" description="Quick reference for all Pokémon type matchups" currentPath="/cheatsheet">
  <h1 style="font-size:16px;font-weight:700;margin:0 0 4px;">Type Matchups</h1>
  <p style="font-size:12px;color:var(--text-muted);margin:0 0 12px;line-height:1.4;">Quick reference for all 18 type matchups. Use Manual Type Check to explore offensive and defensive type interactions.</p>
  <TypeCheckerIsland client:idle />
</MainLayout>

<style is:global>
  .cs-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 8px;
  }

  .cs-card {
    display: flex;
    flex-direction: column;
    border-radius: 10px;
    overflow: hidden;
    border: 1px solid var(--border-subtle);
    background: var(--bg-surface);
  }

  .cs-head {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 5px;
    padding: 7px 6px;
    background: color-mix(in srgb, var(--tc) 14%, transparent);
    border-bottom: 1px solid var(--border-subtle);
  }

  .cs-name {
    font-size: 12px;
    font-weight: 700;
  }

  .cs-body {
    padding: 6px 8px 8px;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .cs-row {
    display: flex;
    align-items: flex-start;
    gap: 6px;
  }

  .cs-label {
    font-size: 9px;
    font-weight: 700;
    color: var(--text-secondary);
    text-transform: uppercase;
    letter-spacing: 0.5px;
    width: 48px;
    flex-shrink: 0;
    line-height: 20px;
  }

  .cs-label--special {
    color: var(--text-muted);
  }

  .cs-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 3px;
  }

  .cs-badge {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 22px;
    height: 22px;
    border-radius: 5px;
    background: var(--bg-hover);
  }

  .cs-badge--resist {
    opacity: 0.6;
  }

  .cs-badge--immune {
    opacity: 0.3;
  }

  .cs-none {
    font-size: 10px;
    color: var(--text-muted);
    line-height: 22px;
  }
</style>
