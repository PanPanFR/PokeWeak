---
import MainLayout from '../../layouts/MainLayout.astro';
import QuickSearch from '../../components/QuickSearch.jsx';
import pokemonData from '../../data/pokemon.json';
import typeChart from '../../data/types.json';
import { calculateWeaknesses } from '../../utils/typeCalc';

export function getStaticPaths() {
  return Object.keys(pokemonData).map((name) => ({
    params: { name },
    props: { data: pokemonData[name] },
  }));
}

const { data } = Astro.props;
const currentKey = Astro.params.name;
const weaknesses = calculateWeaknesses(data.types, typeChart);

// Find mega forms
const megaForms = Object.keys(pokemonData).filter(key => 
  key.startsWith('mega-') && 
  key.includes(currentKey.replace('mega-', '').split('-')[0])
);

// Find alternative forms (rotom-, alola, galar, hisui variants)
const baseName = currentKey.replace(/^mega-/, '').split('-')[0];
const alternativeForms = Object.keys(pokemonData).filter(key => {
  if (key === currentKey || key.startsWith('mega-')) return false;
  const keyBase = key.split('-')[0];
  return keyBase === baseName;
});

const typeColor = (type) => `var(--color-pk-${type.toLowerCase()})`;
const spriteUrl = data.sprite || `https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/${data.id}.png`;
---

<MainLayout title={`${data.name || Astro.params.name} — PokeWeak`} description={`${data.name || Astro.params.name} type weaknesses and resistances`} currentPath={`/pokemon/${Astro.params.name}`}>
  <div class="header-row">
    <a href="/" class="back-link" aria-label="Go back" onclick="history.back();return false">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M19 12H5"/><polyline points="12 19 5 12 12 5"/>
      </svg>
    </a>
    <QuickSearch client:load />
  </div>

  <div style="text-align:center;">
    <img src={spriteUrl} alt={data.name} width="128" height="128" fetchpriority="high" decoding="async" style="image-rendering:pixelated;display:block;margin:0 auto;" />
    <h1 class="heading-glow" style="font-size:24px;font-weight:700;margin:8px 0 4px;">{data.name}</h1>
    <div style="display:flex;gap:8px;justify-content:center;flex-wrap:wrap;">
      {data.types.map((t) => (
        <span style={`display:inline-flex;align-items:center;gap:4px;border-radius:9999px;border:1px solid ${typeColor(t)};background:color-mix(in srgb, ${typeColor(t)} 20%, transparent);padding:4px 12px;font-size:13px;font-weight:500;white-space:nowrap;color:inherit;`}>
          <img src={`/icons/types/${t.toLowerCase()}.svg`} alt={t} width="20" height="20" style="display:inline-block;vertical-align:middle;flex-shrink:0;" />
          <span>{t}</span>
        </span>
      ))}
    </div>
    <div style="margin-top:8px;color:#A0A0A0;font-size:14px;">
      Speed: <strong style="color:#FFFFFF;">{data.speed}</strong>
    </div>
  </div>

  <div style="margin-top:16px;text-align:left;">
    <div style="font-size:13px;font-weight:700;color:#FFFFFF;margin-bottom:8px;text-align:center;">Abilities</div>
    {data.abilities && data.abilities.length > 0 ? (
      <div style="display:flex;flex-direction:column;gap:8px;">
        {data.abilities.map((ab) => {
          const abilityName = typeof ab === 'string' ? ab : ab.name;
          const abilityDesc = typeof ab === 'object' ? ab.description : '';
          return (
            <div style="background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.08);border-radius:8px;padding:10px 12px;">
              <div style="font-size:13px;font-weight:600;color:#FFFFFF;text-transform:capitalize;margin-bottom:4px;">{abilityName}</div>
              {abilityDesc && (
                <div style="font-size:12px;color:#A0A0A0;line-height:1.4;">{abilityDesc}</div>
              )}
            </div>
          );
        })}
      </div>
    ) : (
      <div style="color:#A0A0A0;font-size:13px;text-align:center;">No abilities data</div>
    )}
  </div>

  {megaForms.length > 0 && (
    <div style="margin-top:16px;">
      <div style="font-size:13px;font-weight:700;color:#FFFFFF;margin-bottom:8px;">Mega Forms</div>
      <div style="display:flex;flex-wrap:wrap;gap:6px;">
        {megaForms.map((form) => {
          const formData = pokemonData[form];
          return (
            <a href={`/pokemon/${form}`} style="display:inline-flex;align-items:center;gap:6px;padding:8px 12px;background:#E63946;color:#FFFFFF;border-radius:8px;text-decoration:none;font-size:12px;font-weight:600;transition:background 0.2s;cursor:pointer;" onmouseover="this.style.background='#c92a35'" onmouseout="this.style.background='#E63946'">
              <span>{formData?.name?.replaceAll('-', ' ') || form.replaceAll('-', ' ')}</span>
              {formData?.types && (
                <div style="display:flex;gap:3px;">
                  {formData.types.map((t) => (
                    <img key={t} src={`/icons/types/${t.toLowerCase()}.svg`} alt={t} width="14" height="14" style="display:inline-block;vertical-align:middle;flex-shrink:0;" />
                  ))}
                </div>
              )}
            </a>
          );
        })}
      </div>
    </div>
  )}

{alternativeForms.length > 0 && (
    <div style="margin-top:16px;">
      <div style="font-size:13px;font-weight:700;color:#FFFFFF;margin-bottom:8px;">Alternative Forms</div>
      <div style="display:flex;flex-wrap:wrap;gap:6px;">
        {alternativeForms.map((form) => {
          const formData = pokemonData[form];
          return (
            <a href={`/pokemon/${form}`} style="display:inline-flex;align-items:center;gap:6px;padding:8px 12px;background:#1E40AF;color:#FFFFFF;border-radius:8px;text-decoration:none;font-size:12px;font-weight:600;transition:background 0.2s;cursor:pointer;" onmouseover="this.style.background='#1E3A8A'" onmouseout="this.style.background='#1E40AF'">
              <span>{formData?.name?.replaceAll('-', ' ') || form.replaceAll('-', ' ')}</span>
              {formData?.types && (
                <div style="display:flex;gap:3px;">
                  {formData.types.map((t) => (
                    <img key={t} src={`/icons/types/${t.toLowerCase()}.svg`} alt={t} width="14" height="14" style="display:inline-block;vertical-align:middle;flex-shrink:0;" />
                  ))}
                </div>
              )}
            </a>
          );
        })}
      </div>
    </div>
  )}

  <div class="section-divider"></div>

  <div style="display:flex;flex-direction:column;gap:16px;margin-top:8px;">
    {weaknesses.quadWeak?.length > 0 && (
      <section aria-label="Extremely weak types" class="animate-stagger" style={`--i:0;background:var(--color-surface,#1E1E1E);border-radius:12px;padding:12px;border:1px solid #E6394630;`}>
        <div style="font-size:13px;font-weight:700;color:#E63946;margin-bottom:8px;">Extremely Weak (&times;4)</div>
        <div style="display:flex;flex-wrap:wrap;gap:6px;">
          {weaknesses.quadWeak.map((t) => (
            <span style={`display:inline-flex;align-items:center;gap:4px;color:inherit;background:var(--color-surface-alt,#2A2A2A);border-radius:8px;padding:4px 8px;font-size:12px;`}>
              <img src={`/icons/types/${t.toLowerCase()}.svg`} alt={t} width="16" height="16" style="display:inline-block;vertical-align:middle;flex-shrink:0;" />
              <span>{t}</span>
              <span style="margin-left:auto;font-weight:700;color:#E63946;">&times;4</span>
            </span>
          ))}
        </div>
      </section>
    )}
    {weaknesses.doubleWeak?.length > 0 && (
      <section aria-label="Weak types" class="animate-stagger" style={`--i:1;background:var(--color-surface,#1E1E1E);border-radius:12px;padding:12px;border:1px solid #FF6B3530;`}>
        <div style="font-size:13px;font-weight:700;color:#FF6B35;margin-bottom:8px;">Weak (&times;2)</div>
        <div style="display:flex;flex-wrap:wrap;gap:6px;">
          {weaknesses.doubleWeak.map((t) => (
            <span style={`display:inline-flex;align-items:center;gap:4px;color:inherit;background:var(--color-surface-alt,#2A2A2A);border-radius:8px;padding:4px 8px;font-size:12px;`}>
              <img src={`/icons/types/${t.toLowerCase()}.svg`} alt={t} width="16" height="16" style="display:inline-block;vertical-align:middle;flex-shrink:0;" />
              <span>{t}</span>
              <span style="margin-left:auto;font-weight:700;color:#FF6B35;">&times;2</span>
            </span>
          ))}
        </div>
      </section>
    )}
    {weaknesses.resist?.length > 0 && (
      <section aria-label="Resistant types" class="animate-stagger" style={`--i:2;background:var(--color-surface,#1E1E1E);border-radius:12px;padding:12px;border:1px solid #7AC74C30;`}>
        <div style="font-size:13px;font-weight:700;color:#7AC74C;margin-bottom:8px;">Resists (&times;&frac12;)</div>
        <div style="display:flex;flex-wrap:wrap;gap:6px;">
          {weaknesses.resist.map((t) => (
            <span style={`display:inline-flex;align-items:center;gap:4px;color:inherit;background:var(--color-surface-alt,#2A2A2A);border-radius:8px;padding:4px 8px;font-size:12px;`}>
              <img src={`/icons/types/${t.toLowerCase()}.svg`} alt={t} width="16" height="16" style="display:inline-block;vertical-align:middle;flex-shrink:0;" />
              <span>{t}</span>
              <span style="margin-left:auto;font-weight:700;color:#7AC74C;">&times;&frac12;</span>
            </span>
          ))}
        </div>
      </section>
    )}
    {weaknesses.doubleResist?.length > 0 && (
      <section aria-label="Double resistant types" class="animate-stagger" style={`--i:3;background:var(--color-surface,#1E1E1E);border-radius:12px;padding:12px;border:1px solid #6390F030;`}>
        <div style="font-size:13px;font-weight:700;color:#6390F0;margin-bottom:8px;">Double Resists (&times;&frac14;)</div>
        <div style="display:flex;flex-wrap:wrap;gap:6px;">
          {weaknesses.doubleResist.map((t) => (
            <span style={`display:inline-flex;align-items:center;gap:4px;color:inherit;background:var(--color-surface-alt,#2A2A2A);border-radius:8px;padding:4px 8px;font-size:12px;`}>
              <img src={`/icons/types/${t.toLowerCase()}.svg`} alt={t} width="16" height="16" style="display:inline-block;vertical-align:middle;flex-shrink:0;" />
              <span>{t}</span>
              <span style="margin-left:auto;font-weight:700;color:#6390F0;">&times;&frac14;</span>
            </span>
          ))}
        </div>
      </section>
    )}
    {weaknesses.immune?.length > 0 && (
      <section aria-label="Immune types" class="animate-stagger" style={`--i:4;background:var(--color-surface,#1E1E1E);border-radius:12px;padding:12px;border:1px solid #A0A0A030;`}>
        <div style="font-size:13px;font-weight:700;color:#A0A0A0;margin-bottom:8px;">Immune (&times;0)</div>
        <div style="display:flex;flex-wrap:wrap;gap:6px;">
          {weaknesses.immune.map((t) => (
            <span style={`display:inline-flex;align-items:center;gap:4px;color:inherit;background:var(--color-surface-alt,#2A2A2A);border-radius:8px;padding:4px 8px;font-size:12px;`}>
              <img src={`/icons/types/${t.toLowerCase()}.svg`} alt={t} width="16" height="16" style="display:inline-block;vertical-align:middle;flex-shrink:0;" />
              <span>{t}</span>
              <span style="margin-left:auto;font-weight:700;color:#A0A0A0;">&times;0</span>
            </span>
          ))}
        </div>
      </section>
    )}
  </div>
</MainLayout>


<style is:global>
  .back-link {
    display: inline-flex;
    align-items: center;
    color: #A0A0A0;
    text-decoration: none;
    flex-shrink: 0;
  }
  .header-row {
    display: flex;
    gap: 8px;
    align-items: center;
    margin-bottom: 8px;
  }
  .header-row > *:last-child {
    flex: 1;
  }
</style>
