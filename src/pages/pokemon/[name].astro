---
import MainLayout from '../../layouts/MainLayout.astro';
import QuickSearch from '../../components/QuickSearch.jsx';
import pokemonData from '../../data/pokemon.json';
import typeChart from '../../data/types.json';
import { calculateWeaknesses } from '../../utils/typeCalc';
import { calculateSpeedTiers } from '../../utils/speedCalc';

export function getStaticPaths() {
  return Object.keys(pokemonData).map((name) => ({
    params: { name },
    props: { data: pokemonData[name] },
  }));
}

const { data } = Astro.props;
const currentKey = Astro.params.name;
const weaknesses = calculateWeaknesses(data.types, typeChart);
const speedTiers = calculateSpeedTiers(data.speed);

// Find mega forms
const megaForms = Object.keys(pokemonData).filter(key => 
  key.startsWith('mega-') && 
  key.includes(currentKey.replace('mega-', '').split('-')[0])
);

// Find alternative forms (rotom-, alola, galar, hisui variants)
const baseName = currentKey.replace(/^mega-/, '').split('-')[0];
const alternativeForms = Object.keys(pokemonData).filter(key => {
  if (key === currentKey || key.startsWith('mega-')) return false;
  const keyBase = key.split('-')[0];
  return keyBase === baseName;
});

const typeColor = (type) => `var(--color-pk-${type.toLowerCase()})`;
const spriteUrl = data.sprite || `https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/${data.id}.png`;
---

<MainLayout title={`${data.name || Astro.params.name} — PokeWeak`} description={`${data.name || Astro.params.name} type weaknesses and resistances`} currentPath={`/pokemon/${Astro.params.name}`}>
  <div class="header-row">
    <a href="/" class="back-link" aria-label="Go back" onclick="history.back();return false">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M19 12H5"/><polyline points="12 19 5 12 12 5"/>
      </svg>
    </a>
    <QuickSearch client:load />
  </div>

  <div style="text-align:center;">
    <img src={spriteUrl} alt={data.name} width="128" height="128" fetchpriority="high" decoding="async" style="image-rendering:pixelated;display:block;margin:0 auto;" />
    <h1 class="heading-glow" style="font-size:24px;font-weight:700;margin:8px 0 4px;">{data.name}</h1>
    <div style="display:flex;gap:8px;justify-content:center;flex-wrap:wrap;">
      {data.types.map((t) => (
        <span style={`display:inline-flex;align-items:center;gap:4px;border-radius:9999px;border:1px solid ${typeColor(t)};background:color-mix(in srgb, ${typeColor(t)} 20%, transparent);padding:4px 12px;font-size:13px;font-weight:500;white-space:nowrap;color:inherit;`}>
          <img src={`/icons/types/${t.toLowerCase()}.svg`} alt={t} width="20" height="20" style="display:inline-block;vertical-align:middle;flex-shrink:0;" />
          <span>{t}</span>
        </span>
      ))}
    </div>
  </div>


  <div style="margin-top:24px;text-align:left;">
    <div style="font-size:13px;font-weight:700;color:var(--text-primary);margin-bottom:8px;text-align:center;">Speed Tiers (Lv 50)</div>
    <div style="display:grid;grid-template-columns:repeat(3, 1fr);gap:8px;">
      {[
        { label: 'Base', val: speedTiers.base },
        { label: 'No Invest', val: speedTiers.basePlus },
        { label: 'No Invest+', val: speedTiers.noInvestPlus },
        { label: 'MAX', val: speedTiers.max },
        { label: 'MAX+', val: speedTiers.maxPlus },
        { label: 'Tailwind', val: speedTiers.tailwind }
      ].map((stat) => (
        <div style="background:var(--bg-card);border:1px solid var(--border-subtle);border-radius:8px;padding:8px;text-align:center;">
          <div style="font-size:11px;color:var(--text-secondary);margin-bottom:2px;">{stat.label}</div>
          <div style="font-size:14px;font-weight:700;color:var(--text-primary);">{stat.val}</div>
        </div>
      ))}
    </div>
  </div>

  <div style="margin-top:16px;text-align:left;">
    <div style="font-size:13px;font-weight:700;color:var(--text-primary);margin-bottom:8px;text-align:center;">Abilities</div>
    {data.abilities && data.abilities.length > 0 ? (
      <div style="display:flex;flex-direction:column;gap:8px;">
        {data.abilities.map((ab) => {
          const abilityName = typeof ab === 'string' ? ab : ab.name;
          const abilityDesc = typeof ab === 'object' ? ab.description : '';
          return (
            <div style="background:var(--bg-card);border:1px solid var(--border-subtle);border-radius:8px;padding:10px 12px;">
              <div style="font-size:13px;font-weight:600;color:var(--text-primary);text-transform:capitalize;margin-bottom:4px;">{abilityName}</div>
              {abilityDesc && (
                <div style="font-size:12px;color:var(--text-secondary);line-height:1.4;">{abilityDesc}</div>
              )}
            </div>
          );
        })}
      </div>
    ) : (
      <div style="color:var(--text-secondary);font-size:13px;text-align:center;">No abilities data</div>
    )}
  </div>

  {[
    { title: 'Mega Forms', items: megaForms, color: '#E63946', hover: '#c92a35' },
    { title: 'Alternative Forms', items: alternativeForms, color: '#1E40AF', hover: '#1E3A8A' }
  ].map((formGroup) => formGroup.items.length > 0 && (
    <div style="margin-top:16px;">
      <div style="font-size:13px;font-weight:700;color:var(--text-primary);margin-bottom:8px;">{formGroup.title}</div>
      <div style="display:flex;flex-wrap:wrap;gap:6px;">
        {formGroup.items.map((form) => {
          const formData = pokemonData[form];
          return (
            <a href={`/pokemon/${form}`} style={`display:inline-flex;align-items:center;gap:6px;padding:8px 12px;background:${formGroup.color};color:#FFFFFF;border-radius:8px;text-decoration:none;font-size:12px;font-weight:600;transition:background 0.2s;cursor:pointer;`} onmouseover={`this.style.background='${formGroup.hover}'`} onmouseout={`this.style.background='${formGroup.color}'`}>
              <span>{formData?.name?.replaceAll('-', ' ') || form.replaceAll('-', ' ')}</span>
              {formData?.types && (
                <div style="display:flex;gap:3px;">
                  {formData.types.map((t) => (
                    <img key={t} src={`/icons/types/${t.toLowerCase()}.svg`} alt={t} width="14" height="14" style="display:inline-block;vertical-align:middle;flex-shrink:0;" />
                  ))}
                </div>
              )}
            </a>
          );
        })}
      </div>
    </div>
  ))}

  <div class="section-divider"></div>

  <div style="display:flex;flex-direction:column;gap:16px;margin-top:8px;">
    {[
      { data: weaknesses.quadWeak, title: 'Extremely Weak', multiplierHtml: '&times;4', color: '#E63946' },
      { data: weaknesses.doubleWeak, title: 'Weak', multiplierHtml: '&times;2', color: '#FF6B35' },
      { data: weaknesses.resist, title: 'Resists', multiplierHtml: '&times;&frac12;', color: '#7AC74C' },
      { data: weaknesses.doubleResist, title: 'Double Resists', multiplierHtml: '&times;&frac14;', color: '#6390F0' },
      { data: weaknesses.immune, title: 'Immune', multiplierHtml: '&times;0', color: '#A0A0A0' }
    ].map((section, idx) => section.data?.length > 0 && (
      <section aria-label={`${section.title} types`} class="animate-stagger" style={`--i:${idx};background:var(--color-surface,#1E1E1E);border-radius:12px;padding:12px;border:1px solid ${section.color}30;`}>
        <div style={`font-size:13px;font-weight:700;color:${section.color};margin-bottom:8px;`}>
          {section.title} (<span set:html={section.multiplierHtml} />)
        </div>
        <div style="display:flex;flex-wrap:wrap;gap:6px;">
          {section.data.map((t) => (
            <span style={`display:inline-flex;align-items:center;gap:4px;color:inherit;background:var(--color-surface-alt,#2A2A2A);border-radius:8px;padding:4px 8px;font-size:12px;`}>
              <img src={`/icons/types/${t.toLowerCase()}.svg`} alt={t} width="16" height="16" style="display:inline-block;vertical-align:middle;flex-shrink:0;" />
              <span>{t}</span>
              <span style={`margin-left:auto;font-weight:700;color:${section.color};`} set:html={section.multiplierHtml} />
            </span>
          ))}
        </div>
      </section>
    ))}
  </div>
</MainLayout>


<style is:global>
  .back-link {
    display: inline-flex;
    align-items: center;
    color: var(--text-secondary);
    text-decoration: none;
    flex-shrink: 0;
  }
  .header-row {
    display: flex;
    gap: 8px;
    align-items: center;
    margin-bottom: 8px;
  }
  .header-row > *:last-child {
    flex: 1;
  }
</style>
